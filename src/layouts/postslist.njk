<b>posts</b>
<ul>
  {% for post in collections.posts | reverse %}
  <li>
    {% if post.url == page.url %}<b>{{ post.data.title }} ({{ post.date | date("yyyy-MM-dd") }})</b>{% else %}<a href="{{ post.url }}">{{ post.data.title }} ({{ post.date | date("yyyy-MM-dd") }})</a>{% endif %}
  </li>
  {% endfor %}
</ul>
